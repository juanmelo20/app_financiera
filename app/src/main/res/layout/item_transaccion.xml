<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Separador de fecha estilizado: ... Fecha ... -->
    <TextView
        android:id="@+id/tv_fecha_separador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.5"
        android:textColor="@color/casi_negro"
        android:textSize="13sp"
        tools:text="... 2025-02-18 ..." />

    <!-- Tarjeta suave estilo mockup -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_transaccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="#F6F7FB"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Ícono indicador (Rojo - ó Verde +) -->
            <ImageView
                android:id="@+id/iv_tipo_transaccion"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Tipo de transacción"
                android:src="@drawable/ic_salida_rojo" />

            <!-- Textos principales -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_etiqueta_tipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textColor="@color/casi_negro"
                    android:textSize="13sp"
                    tools:text="Para" />

                <TextView
                    android:id="@+id/tv_nombre_tarjeta_transaccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/casi_negro"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Corresponsal Bancario" />
            </LinearLayout>

            <!-- Monto -->
            <TextView
                android:id="@+id/tv_monto_transaccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/casi_negro"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$ 50.000,00" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
