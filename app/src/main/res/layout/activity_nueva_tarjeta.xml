<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz_nueva_tarjeta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".NuevaTarjeta">

    <!-- Encabezado con estilo Carbón -->
    <LinearLayout
        android:id="@+id/encabezado_nueva_tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/encabezado_fondo"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_nueva_tarjeta"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:navigationIcon="@drawable/ic_launcher_foreground"
            app:title="@string/nueva_tarjeta_titulo"
            app:titleTextColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="@string/nueva_tarjeta_subtitulo"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nombre_tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nueva_tarjeta_nombre_campo">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords|textPersonName"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crear_tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/nueva_tarjeta_btn" />
    </LinearLayout>

</LinearLayout>
