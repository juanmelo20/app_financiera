<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz_enviar_dinero"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".EnviarDinero">

    <!-- Encabezado con estilo Carbón -->
    <LinearLayout
        android:id="@+id/encabezado_enviar_dinero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/encabezado_fondo"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_enviar_dinero"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:navigationIcon="@drawable/ic_launcher_foreground"
            app:title="@string/enviar_titulo"
            app:titleTextColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="@string/enviar_subtitulo"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Selección de Tarjeta de Origen (Desplegable 1) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_origen"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enviar_origen_label">

                <AutoCompleteTextView
                    android:id="@+id/act_origen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selección de Tarjeta Destino (Desplegable 2) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_destino"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/enviar_destino_label">

                <AutoCompleteTextView
                    android:id="@+id/act_destino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Monto a enviar ($) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_monto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/enviar_monto_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_monto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enviar_dinero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/enviar_btn" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
