<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa de abajo: el borde azul -->
    <item>
        <shape>
            <solid android:color="@color/azul" />
            <corners
                android:bottomLeftRadius="48dp"
                android:bottomRightRadius="48dp" />
        </shape>
    </item>
    <!-- Capa de arriba: el carbón, 5dp más corto para que asome el azul -->
    <item android:bottom="5dp">
        <shape>
            <solid android:color="@color/carbon" />
            <corners
                android:bottomLeftRadius="48dp"
                android:bottomRightRadius="48dp" />
        </shape>
    </item>
</layer-list>